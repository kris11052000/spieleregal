{
  "name": "spielregal",
  "productName": "Spielregal",
  "version": "0.4.0",
  "description": "Verwaltung für Videospiele, Konsolen, Wartung und Wunschliste",
  "main": "main.js",
  "author": "Kris",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:mac-intel": "electron-builder --mac --x64 --publish never",
    "dist:mac-arm": "electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.kris.spielregal",
    "productName": "Spielregal",
    "copyright": "Kris",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "igdb.js",
      "services.js",
      "renderer/**/*",
      "!renderer/test.html",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null,
      "artifactName": "Spielregal-${version}-Mac-${arch}.${ext}",
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "title": "Spielregal",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Spielregal-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spielregal",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1031"
    }
  }
}